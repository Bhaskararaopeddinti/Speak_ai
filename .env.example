# LinguaVoice AI Environment Configuration

# Server Port
PORT=5000

# OpenAI API Key (Required for live Whisper, GPT-4o-mini, and TTS-1)
# If left empty, LinguaVoice AI automatically runs in Demo Mode with intelligent linguistic mock simulation.
OPENAI_API_KEY=

# Database Configuration
# Provide a PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/linguavoice)
# If left empty, LinguaVoice AI automatically uses local SQLite (linguavoice.db) with zero manual setup.
DATABASE_URL=

# JWT Secret for user session tokens
JWT_SECRET=linguavoice_super_secret_jwt_key_2026

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
